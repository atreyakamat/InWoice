#!/usr/bin/env bash
# InWoice Environment Configuration
# Copy this file to .env and fill in your actual values

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_PATH=./database.json
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# ==========================================
# OPENROUTER AI CONFIGURATION - PHASE 1
# ==========================================

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=InWoice
HTTP_REFERER=https://inwvoice.app

# ==========================================
# MODEL SELECTION CONFIGURATION
# ==========================================

# Default Models (fallback chain)
DEFAULT_MODEL=gpt-4o-mini
FALLBACK_MODEL=gpt-4o

# Task-Specific Models
INSIGHTS_MODEL=claude-3-sonnet
INSIGHTS_FALLBACK=gpt-4o

PARSING_MODEL=gpt-4-turbo
PARSING_FALLBACK=claude-3-sonnet

FAST_MODEL=gpt-4o-mini
FAST_FALLBACK=gemini-2.0-flash

ANALYSIS_MODEL=claude-3-sonnet
ANALYSIS_FALLBACK=gpt-4

CUSTOMER_MODEL=claude-3-sonnet
CUSTOMER_FALLBACK=gpt-4o

REVENUE_MODEL=claude-3-sonnet
REVENUE_FALLBACK=gpt-4o

RECOMMEND_MODEL=claude-3-sonnet
RECOMMEND_FALLBACK=gpt-4o

CODE_MODEL=gpt-4-turbo
CODE_FALLBACK=claude-3-sonnet

# ==========================================
# MODEL PARAMETERS
# ==========================================

# Temperature: 0.0 (deterministic) to 2.0 (creative)
AI_TEMPERATURE=0.7

# Max tokens per response
AI_MAX_TOKENS=2000

# Context window size
AI_CONTEXT_LENGTH=8000

# Top-P sampling
AI_TOP_P=1

# ==========================================
# AI FEATURE FLAGS
# ==========================================

# Enable AI memory system
ENABLE_AI_MEMORY=true

# Enable recommendation engine
ENABLE_RECOMMENDATIONS=true

# Enable business insights generation
ENABLE_BUSINESS_INSIGHTS=true

# Enable forecasting (future)
ENABLE_FORECASTING=false

# Enable file intelligence
ENABLE_FILE_INTELLIGENCE=false

# ==========================================
# COST TRACKING & BUDGETING
# ==========================================

# Average cost per 1K input tokens (for estimation)
COST_PER_1K_INPUT=0.003

# Average cost per 1K output tokens (for estimation)
COST_PER_1K_OUTPUT=0.009

# Maximum cost allowed per single request (USD)
MAX_COST_PER_REQUEST=1.0

# Monthly AI budget (USD)
MONTHLY_AI_BUDGET=100.0

# ==========================================
# RATE LIMITING
# ==========================================

# Enable rate limiting for AI requests
AI_RATE_LIMITING=true

# Requests allowed per minute
AI_REQUESTS_PER_MINUTE=30

# Requests allowed per hour
AI_REQUESTS_PER_HOUR=500

# Tokens allowed per minute
AI_TOKENS_PER_MINUTE=10000

# ==========================================
# TIMEOUTS
# ==========================================

# AI request timeout in milliseconds
AI_REQUEST_TIMEOUT_MS=30000

# Context assembly timeout in milliseconds
AI_CONTEXT_TIMEOUT_MS=5000

# ==========================================
# CACHING
# ==========================================

# Enable response caching
AI_RESPONSE_CACHE_ENABLED=true

# Cache TTL in seconds (3600 = 1 hour)
AI_RESPONSE_CACHE_TTL=3600

# Max cache size (number of responses)
AI_RESPONSE_CACHE_SIZE=1000

# ==========================================
# LOGGING
# ==========================================

# AI logging level: 'debug', 'info', 'warn', 'error'
AI_LOG_LEVEL=info

# Log all AI requests
AI_LOG_ALL_REQUESTS=true

# Log all AI responses
AI_LOG_ALL_RESPONSES=false

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================

JWT_SECRET=your_jwt_secret_key_change_in_production
ENCRYPTION_KEY=your_encryption_key_change_in_production

# ==========================================
# EMAIL CONFIGURATION
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@inwvoice.app

# ==========================================
# WHATSAPP CONFIGURATION
# ==========================================

WHATSAPP_BUSINESS_ACCOUNT_ID=your_account_id
WHATSAPP_PHONE_NUMBER=your_phone_number
WHATSAPP_API_TOKEN=your_api_token

# ==========================================
# GOOGLE SHEETS INTEGRATION
# ==========================================

GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id

# ==========================================
# CORS & SECURITY
# ==========================================

CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# DEPLOYMENT
# ==========================================

# Vercel deployment
VERCEL_URL=https://your-project.vercel.app

# Docker
DOCKER_ENV=development
