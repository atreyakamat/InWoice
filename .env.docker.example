# Used by docker-compose.yml. Copy to .env next to docker-compose.yml.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional: Claude API key (or set it later in Settings > AI)
ANTHROPIC_API_KEY=
# Optional: with `--profile ai`, use http://ollama:11434
OLLAMA_URL=
# Time zone for report periods, reminder days and backup names
TZ=Asia/Kolkata
# How many daily backups to keep (in the "backups" volume)
BACKUP_KEEP=14
# Public address of this install, e.g. https://billing.example.com (used in emailed links)
APP_URL=
# Operator alerts: server errors and failed jobs are POSTed here (Slack/Discord webhook URL)
ALERT_WEBHOOK_URL=
# --- Hosting many businesses (SaaS). Leave MULTI_TENANT=0 for a single business. ---
MULTI_TENANT=0
# Businesses get <slug>.BASE_DOMAIN; needs a wildcard DNS record and certificate
BASE_DOMAIN=
SIGNUP_ENABLED=0
TRIAL_DAYS=14
PLATFORM_NAME=InWoice
SUPPORT_EMAIL=
# Days of activity log to keep
AUDIT_RETENTION_DAYS=1095
