# ---------------------------------------------------------------
# InWoice backend configuration. Copy to .env and fill in values.
# ---------------------------------------------------------------
NODE_ENV=production
PORT=5000

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://inwoice:CHANGE_ME@127.0.0.1:5432/inwoice?schema=public"
# Separate database used only by `npm test` (it is wiped on every run)
TEST_DATABASE_URL="postgresql://inwoice:CHANGE_ME@127.0.0.1:5432/inwoice_test?schema=public"

# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API. Not needed when the backend
# serves the built frontend itself (same origin).
CORS_ORIGIN=http://localhost:5173

# --- AI (all optional; the app works fully without AI) ---------
# Values saved in Settings > AI override these.
# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Local AI via Ollama (https://ollama.com). Leave blank to disable.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# --- Email (optional; can also be set in Settings) -------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Background jobs ----------------------------------------------
# A backup of all data is written once a day to BACKUP_DIR (relative to backend/).
# Set BACKUP_DIR=off to disable. Copy this folder off the server (see DEPLOYMENT.md).
BACKUP_DIR=backups
BACKUP_KEEP=14
# Report months, reminder days and backup names follow this time zone.
TZ=Asia/Kolkata
# Set to 1 on a second copy of the app so reminders/backups only run once.
DISABLE_SCHEDULER=0

# Public address of this install, e.g. https://billing.example.com. Used in emailed
# links (customer portal, password reset, monthly summaries). Settings can override it.
APP_URL=
# Days of activity (audit) log to keep.
AUDIT_RETENTION_DAYS=1095

# --- Monitoring ------------------------------------------------------
# Server errors, crashes and failed scheduled jobs are POSTed here as JSON
# (works with Slack and Discord incoming webhooks). Throttled; blank = off.
# GET /health also reports version, uptime, memory and the last error.
ALERT_WEBHOOK_URL=

# --- Hosting many businesses (SaaS) ----------------------------------
# Off (0) = one business per install. On = each business gets its own schema and is
# reached at <slug>.BASE_DOMAIN or its own domain. Manage with `npm run platform`.
MULTI_TENANT=0
BASE_DOMAIN=
# Let visitors create a business from the sign-up page (with a free trial).
SIGNUP_ENABLED=0
TRIAL_DAYS=14
PLATFORM_NAME=InWoice
SUPPORT_EMAIL=
# Pick a business with an X-Tenant header (development/testing only).
ALLOW_TENANT_HEADER=0
# Cached database clients for active businesses, and connections each may open.
TENANT_CLIENTS=20
TENANT_CONNECTIONS=3

# --- Connect Gmail (optional) ----------------------------------------
# Google OAuth client (Web application) for "Connect Gmail". Each business can also
# enter its own in Settings › Email. Redirect URI: <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
